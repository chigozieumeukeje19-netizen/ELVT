# ---------------------------------------------------------------------------
# Local development. These three values are printed by `npm run db:start` and
# are the same on every machine, so they are safe to keep in the repo.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the short lived client JWTs handed to Base44 and the PWA.
# Generate with: openssl rand -base64 48
CLIENT_JWT_SECRET=

# Shared secret Base44 sends to POST /api/v1/auth/exchange.
# Generate with: openssl rand -hex 32
PORTAL_API_KEY=

# ---------------------------------------------------------------------------
# Auth email. Resend free tier over Supabase custom SMTP.
# Fill these in, then uncomment [auth.email.smtp] in supabase/config.toml.
# Local development leaves SMTP off and reads magic links from Inbucket.
# ---------------------------------------------------------------------------
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_USER=resend
RESEND_SMTP_PASSWORD=
RESEND_SMTP_ADMIN_EMAIL=
RESEND_SMTP_SENDER_NAME=ELVT

# ---------------------------------------------------------------------------
# AI. Off by default. Every AI job ships as a copyable prompt plus a paste box
# until this is set to a real provider, so nothing here costs money.
# ---------------------------------------------------------------------------
AI_PROVIDER=off
AI_API_KEY=

# ---------------------------------------------------------------------------
# Seed accounts. Used by `npm run db:seed` and the Playwright tests.
# ---------------------------------------------------------------------------
SEED_COACH_EMAIL=coach@elvt.test
SEED_COACH_PASSWORD=ElvtCoach2026
