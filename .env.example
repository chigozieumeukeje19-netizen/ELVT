# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in before running the gate:
#
#   cp .env.example .env.local
#   supabase start
#   supabase status        # prints the four values below
#
# .env.local is gitignored. Nothing here is a secret worth protecting on a
# local stack; the same file on production is.
# ---------------------------------------------------------------------------

# supabase status: "API URL"
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# supabase status: "anon key" on an older CLI, "Publishable key" on a newer one.
# Both formats work. A newer CLI prints sb_publishable_..., an older one prints
# a JWT starting eyJ. Paste whichever yours shows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# supabase status: "service_role key" on an older CLI, "Secret key" on a newer
# one. Same story: sb_secret_... or a JWT starting eyJ, both accepted.
# Server side only. Never exposed to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# supabase status: "JWT secret".
#
# This is NOT one of the two keys above and is not replaced by the new key
# format. It signs the short lived client tokens that POST /api/v1/auth/exchange
# hands to Base44, and PostgREST validates them against it. On a local stack it
# is the fixed value below unless config.toml changes it.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Yours to invent. The shared secret Base44 sends to the exchange endpoint.
#   openssl rand -hex 32
PORTAL_API_KEY=

# ---------------------------------------------------------------------------
# Auth email. Resend free tier over Supabase custom SMTP.
# Fill these, then uncomment [auth.email.smtp] in supabase/config.toml.
# Local development leaves SMTP off and reads magic links from Inbucket at
# http://127.0.0.1:54324
# ---------------------------------------------------------------------------
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_USER=resend
RESEND_SMTP_PASSWORD=
RESEND_SMTP_ADMIN_EMAIL=
RESEND_SMTP_SENDER_NAME=ELVT

# ---------------------------------------------------------------------------
# AI. Off by default. Every AI job ships as a copyable prompt plus a paste box
# until this names a real provider, so a default install never reaches a paid
# endpoint.
# ---------------------------------------------------------------------------
AI_PROVIDER=off
AI_API_KEY=

# ---------------------------------------------------------------------------
# Seed accounts, used by the seed and the Playwright auth tests.
# ---------------------------------------------------------------------------
SEED_COACH_EMAIL=coach@elvt.test
SEED_COACH_PASSWORD=ElvtCoach2026
SEED_CLIENT_EMAIL=nadia.brookes@elvt.test
SEED_CLIENT_PASSWORD=ElvtClient2026

# ---------------------------------------------------------------------------
# Only on a machine with no Supabase. Everything that talks to Postgres reads
# this, defaulting to the local Supabase stack, so normally it stays unset.
# ---------------------------------------------------------------------------
# ELVT_DB_URL=postgresql://postgres@127.0.0.1:5433/postgres
